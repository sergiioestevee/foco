{
  "expo": {
    "name": "Foco",
    "slug": "foco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foco-icon-dark.png",
    "scheme": "foco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/foco-icon-light.png",
        "dark": "./assets/foco-icon-dark.png"
      },
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0E",
        "foregroundImage": "./assets/foco-icon-dark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/foco-icon-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F7",
          "image": "./assets/splash-logo-light.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E0F13",
            "image": "./assets/splash-logo-dark.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8232f24-589a-4958-b76d-5cd34649d68b"
      }
    },
    "owner": "sergiioesteveees-team"
  }
}
